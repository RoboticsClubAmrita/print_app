# ==========================================================
# Backend server configuration
# Only ONE API_BASE_URL line should be active (uncommented).
# The other is hashed out with a leading '#' — swap them when
# moving between local development and the deployed server.
# ==========================================================

# --- Local development backend (LAN IP, same Wi-Fi as this machine) ---
# API_BASE_URL=http://10.117.114.18:5000/api

# --- Deployed server backend (AWS EC2) ---
API_BASE_URL=http://13.60.246.95/api

# --- Upload limit ---
# Must match MAX_UPLOAD_MB in the backend's .env. Mirrored here only so an
# oversized document is rejected before uploading; the server still enforces it.
MAX_UPLOAD_MB=50
